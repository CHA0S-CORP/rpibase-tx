# rpibase-tx configuration

# TX backend: "mock" (no hardware, safe for dev) or "real" (spawns rpitx binaries)
RPITX_MODE=mock

# Directory holding rpitx binaries (tune, pifmrds, pocsag, sendiq, pisstv, pichirp)
BIN_DIR=/opt/rpitx

# Comma-separated allowed frequency ranges in Hz: "low-high,low-high"
# Default below is the 70cm amateur band + 434 MHz ISM. EDIT for your license/region.
FREQ_ALLOWLIST=430000000-440000000

# Watchdog: auto-kill any transmission after this many seconds. Startup value;
# adjustable at runtime from the dashboard Limits card or PUT /api/settings.
# 0 = watchdog off (transmissions run until the process exits or STOP).
MAX_TX_SECONDS=60

# Absolute ceiling the runtime watchdog setting can never exceed.
MAX_TX_SECONDS_HARD=600

# Directory for uploaded audio/image/IQ files (POST /api/upload). TX file
# params (audio_file/iq_file/image_file) must point inside this directory.
UPLOAD_DIR=uploads

# Set to true to allow TX file params anywhere on the host. Off by default —
# the service runs as root on the Pi.
# ALLOW_ANY_PATH=false

# Host-global lock guarding the single physical transmitter (empty = temp dir).
# Set to a fixed path so the single-TX guarantee holds across uvicorn workers.
# TX_LOCK_FILE=/run/rpitx-dashboard/tx.lock
