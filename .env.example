# rpibase-tx configuration

# TX backend: "mock" (no hardware, safe for dev) or "real" (spawns rpitx binaries)
RPITX_MODE=mock

# Directory holding rpitx binaries (tune, pifmrds, pocsag, sendiq, pisstv, pichirp)
BIN_DIR=/opt/rpitx

# Comma-separated allowed frequency ranges in Hz: "low-high,low-high"
# Default below is the 70cm amateur band + 434 MHz ISM. EDIT for your license/region.
FREQ_ALLOWLIST=430000000-440000000

# Hard cap on any transmission length in seconds (watchdog auto-kills)
MAX_TX_SECONDS=60

# Directory for uploaded audio/image/IQ files (POST /api/upload)
UPLOAD_DIR=uploads

# Host-global lock guarding the single physical transmitter (empty = temp dir).
# Set to a fixed path so the single-TX guarantee holds across uvicorn workers.
# TX_LOCK_FILE=/run/rpitx-dashboard/tx.lock
